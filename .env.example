# Copy to .env and change what you need. Everything has a default.

# Where the web app answers: http://127.0.0.1:8096
WEB_BIND=127.0.0.1
WEB_PORT=8096

# Database password (the database is not published outside the compose network).
DB_PASSWORD=jugrid

# Years per climate period: 20 compares 1995-2014 with 2041-2060. Each year is four
# files of about 250 MB per scenario, so 20 years download about 60 GB once; 5 is a quick try.
PERIOD_YEARS=20
DOWNLOAD_WORKERS=4
